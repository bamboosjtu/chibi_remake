{
  "description": "Lightweight GitHub gate: no LFS assets, no export templates, first-map simulation and runtime script compilation.",
  "tests": [
    {
      "script": "test_unit_state_transitions",
      "markers": ["UNIT STATE TRANSITIONS PASS", "HARVEST TRANSITIONS PASS", "WOOD TRANSITIONS PASS"],
      "args": ["--noview"],
      "timeout": 120
    },
    {
      "script": "check_runtime_scripts",
      "markers": [
        "RUNTIME SCRIPTS PASS"
      ],
      "timeout": 120
    },
    {
      "script": "test_architecture",
      "markers": [
        "ARCH-019 PASS",
        "ARCH-017/018 PASS",
        "ARCH-022 budget selection PASS"
      ],
      "args": [
        "--noview"
      ],
      "timeout": 120
    },
    {
      "script": "dump_composition",
      "markers": [
        "COMPOSITION PASS"
      ],
      "args": [
        "--noview"
      ]
    },
    {
      "script": "test_presentation_diagnostics",
      "markers": [
        "PRESENTATION DIAGNOSTICS PASS"
      ]
    },
    {
      "script": "test_camera_read_model",
      "markers": [
        "CAMERA READ MODEL PASS"
      ],
      "args": [
        "--noview"
      ]
    },
    {
      "script": "test_rule_catalog",
      "markers": [
        "RULE CATALOG PASS"
      ],
      "args": [
        "--noview"
      ]
    },
    {
      "script": "test_rule_constants",
      "markers": [
        "RULE CONSTANTS PASS"
      ],
      "args": [
        "--noview"
      ]
    },
    {
      "script": "test_pause_ownership",
      "markers": [
        "PAUSE OWNERSHIP PASS"
      ],
      "args": [
        "--pause-unit-only"
      ]
    },
    {
      "script": "test_app_boundaries",
      "markers": [
        "APP BOUNDARIES PASS"
      ],
      "args": [
        "--noview"
      ]
    },
    {
      "script": "test_command_determinism",
      "markers": [
        "COMMAND DETERMINISM PASS"
      ],
      "args": [
        "--noview"
      ]
    }
  ]
}
