{
  "description": "CPU-only hosted save gate. Overlay of required release tests; no LFS art or export templates.",
  "tests": [
    {
      "script": "test_save_roundtrip",
      "markers": [
        "SAVE ROUNDTRIP PASS"
      ],
      "args": [
        "--noview"
      ]
    },
    {
      "script": "test_save_validity",
      "markers": [
        "SAVE VALIDITY PASS",
        "CURRENT REQUIRED FIELDS PASS"
      ],
      "args": [
        "--noview"
      ],
      "timeout": 120
    },
    {
      "script": "test_unit_schema",
      "markers": [
        "UNIT SCHEMA PASS",
        "UNIT RECORD SCHEMA PASS"
      ],
      "args": [
        "--noview"
      ],
      "timeout": 150
    },
    {
      "script": "test_current_format",
      "markers": [
        "CURRENT FORMAT PASS"
      ],
      "args": [
        "--noview"
      ],
      "timeout": 240
    },
    {
      "script": "test_rules_scope",
      "markers": [
        "RULES SCOPE PASS"
      ],
      "args": [
        "--noview"
      ]
    },
    {
      "script": "test_app_services",
      "markers": [
        "APP SERVICES PASS"
      ],
      "args": [
        "--noview"
      ]
    },
    {
      "script": "test_snapshot_stages",
      "markers": [
        "SNAPSHOT STAGES PASS"
      ],
      "args": [
        "--noview"
      ]
    },
    {
      "script": "test_save_semantics",
      "markers": [
        "SAVE SEMANTICS PASS"
      ],
      "args": [
        "--noview"
      ],
      "timeout": 150
    },
    {
      "script": "test_save_boundaries",
      "markers": [
        "SAVE BOUNDARIES PASS"
      ],
      "args": [
        "--noview"
      ],
      "timeout": 150
    }
  ]
}
