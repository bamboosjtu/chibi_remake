/_tools/
/_rea/
/_rea-*/
/rea/
/.rea/
/.workbuddy/
/赤壁简体中文光盘版/
tmp/
/发布/
userdata/

# Build outputs and test results.
/release/
/build/
/dist/
/out/
/artifacts/
/coverage/
/test-results/
/playwright-report/
*.exe
*.pck
*.pck.*
*.dll
*.pdb
*.obj
*.o
*.a
*.so
