*.webm
*.pal
*.lwc
*.LWC
*.exp
*.EXP
*.idx
*.import
/godot/chibi_remake/media/*
/godot/chibi_remake/media/**/*.json
/godot/chibi_remake/art/production/references/
/research/**/assets/
/godot/chibi_remake/art/remake_hd/
/godot/chibi_remake/art/source_fallback/
/godot/chibi_remake/sprites/
/godot/chibi_remake/sprites_hd/
/godot/chibi_remake/terrain_hd/

# Keep script/resource UIDs; metadata belonging to local assets stays local.
*.png.uid
*.jpg.uid
*.jpeg.uid
*.svg.uid
*.wav.uid
*.ogg.uid
*.avi.uid
*.AVI.uid
*.ogv.uid
*.otf.uid
*.ttf.uid

# Editor/import and dependency caches.
**/.godot/
**/.import/
**/node_modules/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.cache/
**/.vs/

# Temporary files and operating-system metadata.
*.log
*.log.*
*.stdout
*.stderr
*.err
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Process drafts and generated reports; retain formal specifications/contracts.
/docs/changes/
/docs/drafts/
/docs/*-report.json
/docs/*-verification.json
/docs/img/
!/docs/assets/poster.jpg
/godot/chibi_remake/art/production/screenshots/
/godot/chibi_remake/art/production/*-report.json
/godot/chibi_remake/art/production/*-verification.json
/godot/chibi_remake/art/production/runtime-cleanliness.json
/godot/chibi_remake/art/production/runtime-hd-coverage.json
/godot/chibi_remake/art/production/progress.json
/godot/chibi_remake/art/production/generation-jobs.json
/godot/chibi_remake/art/production/gallery.html
/godot/chibi_remake/art/production/catalog-before-*.json
/godot/chibi_remake/art/production/team-mask-contract.json

# Local extraction scripts; maintained import/build tools live under tools/.
/research/**/tools/
/research/**/*.py
/research/**/*.ps1
/research/**/*.mjs
/research/**/*.js

